{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ---------------------------------------------------------------------------
  // NO CLOUDFLARE ACCOUNT IS ATTACHED TO THIS PROJECT YET.
  // Everything runs under local emulation: `wrangler dev` with no --remote.
  // Any value that becomes account-scoped is marked `PLACEHOLDER` below.
  //
  // Remote resources that must be created before a first deploy, in order:
  //   1. d1        bank-recon          -> fills in `database_id` below
  //   2. r2        bank-recon-audit    -> PRIVATE, see the r2_buckets note
  //   3. queue     txn-events
  //   4. queue     txn-events-dlq
  //   5. secret    SIMULATOR_TOKEN
  //   6. Cloudflare Access on the Worker route  (BEFORE step 7; the read API
  //      is unauthenticated and step 7 is what makes the data real)
  //   7. domain + Email Routing rule    (last; needs a purchased domain)
  // The exact commands are in docs/CLOUDFLARE_SETUP.md.
  // ---------------------------------------------------------------------------
  "name": "bank-email-reconciliation",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },

  // The dashboard is served by this same Worker as static assets rather than by
  // a separate Pages project. One deploy, one origin, so the browser calls
  // /api/... same-origin and there is no CORS layer to configure or explain.
  // A request that matches a file here is served from the edge without invoking
  // the Worker; everything else falls through to fetch(), which is what keeps
  // /api and /webhook working. See docs/DECISIONS.md 5.1.
  "assets": {
    "directory": "./public"
  },

  // Deployed values. `.dev.vars` overrides these locally; see .dev.vars.example.
  "vars": {
    // How much of the account space POST /webhook is allowed to write to.
    //
    // "demo-accounts-only" is the deployed setting and the safe default: the
    // simulator can only touch account ids whose label starts with DEMO-, so a
    // leaked SIMULATOR_TOKEN cannot inject fabricated transactions into a real
    // account's balance chain. Local development sets "any-account" in
    // .dev.vars, because tests and the local demo post to ordinary ids.
    //
    // Anything other than the exact string "any-account" restricts, including
    // an unset value. See docs/DECISIONS.md 7.2.
    "SIMULATOR_SCOPE": "demo-accounts-only"
  },

  // One Worker exports all three handlers:
  //   fetch() - dashboard API + the /webhook simulator ingress
  //   email() - real bank-email ingress via Email Routing
  //   queue() - the consumer that audits to R2 and drives the ledger DO
  "queues": {
    "producers": [
      { "binding": "TXN_QUEUE", "queue": "txn-events" }
    ],
    "consumers": [
      {
        "queue": "txn-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        // Poison events stop blocking the pipeline and land here instead.
        "dead_letter_queue": "txn-events-dlq"
      },
      {
        // The dead-letter queue has its own consumer so a poisoned event is
        // recorded rather than silently accumulating in a queue nobody reads.
        // It only logs: whatever failed five times on the main queue will fail
        // here too, so retrying is pointless and this consumer always acks.
        "queue": "txn-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 0
      }
    ]
  },

  // SQLite-backed DO: an account ledger never goes terminal, so the event log
  // has to be an indexed table, not a JSON blob rewritten on every event.
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT_LEDGER", "class_name": "AccountLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountLedger"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bank-recon",
      // PLACEHOLDER - replace after account creation.
      // `wrangler d1 create bank-recon` prints the real uuid. Local
      // `wrangler dev` never reads this value, so the placeholder is inert
      // until the first remote command. See docs/CLOUDFLARE_SETUP.md step 3.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],

  // PRIVATE BUCKET - DO NOT MAKE PUBLIC.
  // This bucket stores raw bank emails verbatim: real names, real account
  // numbers, real balances, real merchants. It must never have a public custom
  // domain attached and must never have r2.dev public access enabled.
  // README screenshots and other demo assets that are too large for git go in a
  // SEPARATE public bucket named `bank-recon-assets`, never in this one.
  "r2_buckets": [
    { "binding": "AUDIT", "bucket_name": "bank-recon-audit" }
  ]

  // Email Routing is configured in the Cloudflare dashboard (route an address at
  // your domain to this Worker). Receiving mail needs no binding block here -
  // only the exported email() handler. Sending or forwarding onward would need a
  // send_email binding; this Worker does neither.
}
