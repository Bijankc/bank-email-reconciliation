{
  "name": "bank-email-reconciliation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:local": "wrangler d1 execute bank-recon --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute bank-recon --remote --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "postal-mime": "^3.0.0"
  }
}
